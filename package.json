{
  "name": "ribo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "pnpm -r --parallel typecheck",
    "build:packages": "pnpm -r --filter \"./packages/*\" build",
    "build:app": "pnpm --filter playground build",
    "build": "pnpm build:packages && pnpm build:app",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "./check.sh",
    "check:resolve": "node scripts/assert-source-condition.mjs",
    "check:pkg": "node scripts/pkg-gates.mjs",
    "test:pack-and-consume": "node scripts/pack-and-consume/index.mjs",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "docs:api": "typedoc --options docs/typedoc.json",
    "docs:accuracy": "node scripts/generate-accuracy-page.mjs",
    "docs:dev": "pnpm run docs:api && pnpm run docs:accuracy && vitepress dev docs",
    "docs:build": "pnpm run docs:examples && pnpm run docs:api-examples && pnpm run docs:api && pnpm run docs:accuracy && vitepress build docs",
    "docs:deploy": "pnpm run docs:build && helix deploy",
    "docs:examples": "tsc -p docs/api/examples",
    "docs:api-examples": "node scripts/check-api-examples.mjs",
    "target:refresh": "node scripts/refresh-target.mjs",
    "snugg:refresh": "node scripts/snugg-descriptions.mjs --refresh",
    "snugg:check": "node scripts/snugg-descriptions.mjs --check",
    "skips:check": "node scripts/skip-inventory.mjs"
  },
  "devDependencies": {
    "@azx/ribo-adapter-snuggpro": "workspace:*",
    "@azx/ribo-chat-helix": "workspace:*",
    "@azx/ribo-chat-openai": "workspace:*",
    "@azx/ribo-core": "workspace:*",
    "@azx/ribo-extractor-ondevice": "workspace:*",
    "@azx/ribo-extractor-systemone": "workspace:*",
    "@azx/ribo-systemone-managed": "workspace:*",
    "@azx/ribo-storage-rxdb": "workspace:*",
    "@azx/ribo-transcriber-managed": "workspace:*",
    "@azx/ribo-transcriber-managed-docs": "workspace:*",
    "@azx/ribo-transcriber-ondevice": "workspace:*",
    "@azx/ribo-transcriber-pdfjs": "workspace:*",
    "@azx/ribo-ui-react": "workspace:*",
    "@changesets/cli": "catalog:",
    "@eslint/js": "10.0.1",
    "@huggingface/transformers": "catalog:",
    "@types/node": "catalog:",
    "@vitest/browser": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "browserslist": "catalog:",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "playwright": "catalog:",
    "prettier": "3.9.9",
    "typedoc": "catalog:",
    "typedoc-plugin-markdown": "catalog:",
    "typedoc-vitepress-theme": "catalog:",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "catalog:",
    "vitepress": "catalog:",
    "vitest": "5.0.3",
    "zod": "catalog:"
  },
  "pnpm": {
    "overrides": {
      "onnxruntime-web": "1.27.0",
      "fast-uri": "^3.1.8",
      "postcss": "^8.5.29",
      "sharp": "^0.35.5",
      "adm-zip": "^0.6.1",
      "brace-expansion@>=2.0.0 <3": "^2.1.7",
      "brace-expansion@>=4": "^5.0.12",
      "js-yaml@3": "^3.15.2",
      "js-yaml@4": "^4.3.2",
      "markdown-it": "^14.3.2",
      "nanoid@3": "^3.3.20"
    }
  }
}
