{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "rooms": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "heatingLoad": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "sourceSpan": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": ["name", "heatingLoad", "sourceSpan"],
        "additionalProperties": false
      }
    },
    "report": {
      "type": "object",
      "properties": {
        "summary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceSpan": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["summary", "sourceSpan"],
      "additionalProperties": false
    },
    "utilities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "account": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": ["account"],
        "additionalProperties": false
      }
    },
    "basedata": {
      "type": "object",
      "properties": {
        "yearBuilt": {
          "type": "object",
          "properties": {
            "value": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "confidence": {
              "type": "number"
            },
            "sourceSpan": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": ["value", "confidence", "sourceSpan"],
          "additionalProperties": false
        }
      },
      "required": ["yearBuilt"],
      "additionalProperties": false
    }
  },
  "required": ["rooms", "report", "utilities", "basedata"],
  "additionalProperties": false
}
