{
  "name": "@azx/ribo-adapter-snuggpro",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "@azx/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./extraction.schema.json": "./dist/extraction.schema.json",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "restricted",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./extraction.schema.json": "./dist/extraction.schema.json",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "typecheck": "tsc -b --force",
    "build": "tsdown --no-publint --no-attw && node ./generate-extraction-schema.mjs && tsdown"
  },
  "dependencies": {
    "@azx/ribo-core": "workspace:^",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "catalog:",
    "@azx/build-config": "workspace:*",
    "@azx/ribo-chat-openai": "workspace:*",
    "@azx/ribo-cli": "workspace:*",
    "@azx/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "ajv": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
