node_modules/
dist/
coverage/
.turbo/
.vite/
*.tsbuildinfo
.DS_Store
*.local

# VitePress build output + cache, and the TypeDoc-generated API Reference. All three are
# regenerated by the `docs:*` scripts (`docs:api` writes docs/reference/) — never edited by hand,
# never committed.
docs/.vitepress/cache/
docs/.vitepress/dist/
docs/reference/

# Vitest browser mode's failure artifacts — attachments and screenshots taken
# when a browser test fails. Regenerated on the next run; never reviewed as source.
# The glob is deliberate: Vitest writes the directory next to the test file that
# failed, so a fixed path only covers wherever a test happened to fail first.
.vitest-attachments/
**/__screenshots__/

# Manual extraction acceptance-gate outputs (Phase 4 Task 3): per-transcript
# extractor results from a live, keyed run against the spike corpus. Regenerable,
# needs a key, noisy — never committed. The gate computes its verdict in-process;
# these files are only for a human to re-inspect or re-score with score.mjs.
packages/ribo-adapter-snuggpro/acceptance/results/

# local production preview build (manual, separate from dist/)
playground/dist-preview/

# Same-origin ONNX Runtime files, copied out of onnxruntime-web/dist by
# `serveOrtRuntime` in playground/vite.config.ts. A regenerable copy of a
# dependency — rebuilt on every dev/build, never edited by hand.
playground/public/ort/

# Regenerable test audio fixtures (say/afconvert; see transcribe.manual.ts header)
**/testdata/*.wav

# On-device transcription MEASUREMENT spike (Phase 3 Task 4): regenerable audio manifest and the
# raw, per-model Whisper transcripts + blind extraction outputs. The measured summaries
# (results/metrics-*.json, results/partb-*-score.json) ARE committed.
spikes/transcription-measurement/testdata/manifest.json
spikes/transcription-measurement/results/ondevice/
spikes/transcription-measurement/results/extract/

# Snugg Pro's proprietary API artifacts — NEVER commit. Kept only in the private
# integration notes outside this repo. Both are third-party vendor IP:
#   * snuggpro-openapi.json — the vendor's own OpenAPI (Swagger 2.0) spec.
#   * snugg-pro.html        — the 4.8 MB Redoc render of that same spec.
# These must not re-enter the public tree.
docs/implementation/snuggpro-openapi.json
snugg-pro.html

# Agent scratch: isolated git worktrees created by the harness, and the
# subagent-driven-development workspace (ledger, task briefs, review packages).
# Both are regenerable coordination state, never part of the source tree.
.claude/worktrees/
.superpowers/

# Internal specs and plans, kept on disk for local reference but untracked.
# Distinct from .superpowers/ above: .superpowers/ is coordination scratch
# (ledger, task briefs), while docs/superpowers/ is internal design specs and
# per-phase plans. Both are implementation detail; neither belongs in a
# public repo, and the directory was never published to the docs site either
# (excluded via srcExclude in docs/.vitepress/config.ts).
docs/superpowers/
