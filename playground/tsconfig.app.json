{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@azx/tsconfig/react-library.json",
  "compilerOptions": {
    // Required so the solution config below can reference this project.
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo"
  },
  // Browser code only. Deliberately no `"types": ["node"]` — nothing under
  // src/ may reach for Node built-ins.
  "include": ["src"]
}
