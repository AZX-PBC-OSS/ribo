{
  "$schema": "https://typedoc.org/schema.json",
  "plugin": ["typedoc-plugin-markdown", "typedoc-vitepress-theme"],
  "entryPoints": [
    "../packages/ribo-core/src/index.ts",
    "../packages/ribo-core/src/testing.ts",
    "../packages/ribo-core/src/worklet.ts",
    "../packages/ribo-adapter-snuggpro/src/index.ts",
    "../packages/ribo-chat-helix/src/index.ts",
    "../packages/ribo-chat-openai/src/index.ts",
    "../packages/ribo-extractor-ondevice/src/index.ts",
    "../packages/ribo-extractor-systemone/src/index.ts",
    "../packages/ribo-systemone-managed/src/index.ts",
    "../packages/ribo-storage-rxdb/src/index.ts",
    "../packages/ribo-transcriber-managed/src/index.ts",
    "../packages/ribo-transcriber-managed-docs/src/index.ts",
    "../packages/ribo-transcriber-ondevice/src/index.ts",
    "../packages/ribo-transcriber-ondevice/src/worker.ts",
    "../packages/ribo-transcriber-pdfjs/src/index.ts",
    "../packages/ribo-ui-react/src/index.ts"
  ],
  "tsconfig": "./typedoc.tsconfig.json",
  "out": "./reference",
  "name": "API Reference",
  "readme": "none",
  "treatWarningsAsErrors": true,
  "defaultCategory": "Other",
  "categoryOrder": [
    "Captures & Sources",
    "Transcription",
    "Extraction",
    "Arbitration & Fallback",
    "Sessions",
    "Provenance",
    "Review",
    "Write-back",
    "Offline & Storage",
    "Plugin Storage",
    "Connectivity",
    "React Hooks",
    "Chat Transports",
    "Tool Adapters",
    "Errors",
    "Other"
  ],
  "hideGenerator": true,
  "excludeInternal": true,
  "excludePrivate": true,
  "githubPages": false,
  "disableSources": true,
  "useCodeBlocks": true,
  "expandObjects": true,
  "docsRoot": ".",
  "blockTags": [
    "@module",
    "@category",
    "@file",
    "@param",
    "@returns",
    "@throws",
    "@typeParam",
    "@remarks",
    "@see",
    "@example",
    "@deprecated",
    "@internal",
    "@private",
    "@protected",
    "@alpha",
    "@beta",
    "@experimental",
    "@default",
    "@hidden",
    "@ignore"
  ]
}
